# Server-only example; all credentials below are deliberately empty.
# Run scripts/elevenlabs_setup.py init with backend/.venv/bin/python to
# create/update root .env safely, preserving any existing local values.
# Never prefix these variables with VITE_ or paste keys into chat/source.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Generate a random secret of at least 32 characters; use an ElevenLabs workspace secret.
HEARTH_WEBHOOK_SECRET=
# HTTPS tunnel to 127.0.0.1:8001 only (never ports 8000 or 5173).
HEARTH_VOICE_PUBLIC_URL=
# Finite local call/binding duration, clamped to 60–600 seconds.
HEARTH_VOICE_MAX_SECONDS=600
# Optional shared database location for BOTH the API and voice gateway.
# Default: backend/data/repairs.sqlite3. Use an absolute path if overriding.
# REPAIR_DB_PATH=/absolute/path/to/repairs.sqlite3
